{
  "name": "devianns-clip-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "checklist:check": "node scripts/check-checklist.mjs",
    "build": "npm run checklist:check && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-test.mjs",
    "test:preview": "node scripts/preview-test.mjs"
  },
  "dependencies": {
    "mediabunny": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.56.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
